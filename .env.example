# =============================================================
#  Parivar Restaurant — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# =============================================================

# ── Frontend (Vite / Vercel) ──────────────────────────────────
# NOTE: Do NOT append '/api/v1' to VITE_API_URL or '/ws' to VITE_WS_URL!
# The frontend code appends those paths automatically.

# LOCAL development:
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# PRODUCTION (Set in Vercel Dashboard → Settings → Environment Variables):
# Primary Custom Domain:
# VITE_API_URL=https://api.parivar.restaurant
# VITE_WS_URL=wss://api.parivar.restaurant

# Staging / Backup Render Options (if not using custom domain):
# Option A (Active Backup):
# VITE_API_URL=https://parivar-restaurant-backend.onrender.com
# VITE_WS_URL=wss://parivar-restaurant-backend.onrender.com
# Option B (Previous/Final):
# VITE_API_URL=https://parivar-restaurant-final.onrender.com
# VITE_WS_URL=wss://parivar-restaurant-final.onrender.com

# ── Backend (FastAPI / Render) ────────────────────────────────
# Set these in Render Dashboard → Environment (or via render.yaml):

# Python runtime (Render defaults to 3.13 which breaks; 3.12 is required):
PYTHON_VERSION=3.12.10

# Database:
# LOCAL:
DATABASE_URL=sqlite+aiosqlite:///./parivar.db
# PRODUCTION (Neon PostgreSQL — direct endpoint, asyncpg dialect, no ?sslmode param):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-direct-endpoint>.aws.neon.tech/<dbname>

# JWT Authentication:
SECRET_KEY=supersecretkey-change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated, no trailing slashes, never '*' in prod):
# Includes production domain, gamma preview, final preview, and local dev:
CORS_ORIGINS=https://parivar.restaurant,https://www.parivar.restaurant,https://parivar-restaurant-gamma.vercel.app,https://parivar-restaurant-final.vercel.app,http://localhost:5173
